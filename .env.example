# One settings file for the whole app.
# Copy it:  cp .env.example .env   and fill in your Groq key.
# It is used by docker compose and by the backend when you run it without Docker.

# ---- Backend ----
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional: a second key, used when the first is busy (rate limited), refused or down.
GROQ_FALLBACK_API_KEY=

# Optional (these are the defaults):
# GROQ_MODEL=openai/gpt-oss-20b
# MAX_UPLOAD_MB=50
# QUESTION_DEADLINE_SECONDS=60
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Frontend ----
# The backend address your browser uses. Only this one value is given to the frontend,
# so the Groq key never ends up in the website.
NEXT_PUBLIC_API_URL=http://localhost:8000
